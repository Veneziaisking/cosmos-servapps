{
  "name": "Jellyfin",
  "cosmos-installer": {
    "form": [
      {
        "name": "MediaRoot",
        "label": "Host Media Root Path",
        "initialValue": "{DefaultDataPath}/media",
        "type": "text",
        "required": true
      },
      {
        "name": "ConfigRoot",
        "label": "Host Config Root Path",
        "initialValue": "/srv/config",
        "type": "text",
        "required": true
      },
      {
        "name": "PUID",
        "label": "Container User ID (PUID)",
        "initialValue": "1001",
        "type": "text",
        "required": true
      },
      {
        "name": "PGID",
        "label": "Container Group ID (PGID)",
        "initialValue": "1001",
        "type": "text",
        "required": true
      },
      {
        "name": "adminOnly",
        "label": "Do you want to make this service admin only?",
        "initialValue": false,
        "type": "checkbox"
      }
    ]
  },
  "minVersion": "0.9.0",
  "services": {
    "{ServiceName}": {
      "image": "lscr.io/linuxserver/jellyfin:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "environment": [
        "PUID={Context.PUID}",
        "PGID={Context.PGID}",
        "TZ=Europe/Copenhagen"
      ],
      "volumes": [
        {
          "source": "{Context.ConfigRoot}/{ServiceName}",
          "target": "/config",
          "type": "bind"
        },
        {
          "source": "{Context.MediaRoot}",
          "target": "/media",
          "type": "bind"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:8096",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          },
          "AuthEnabled": true
          {if Context.adminOnly}
          ,
          "AuthAdmin": true
          {/if}
        }
      ],
      "labels": {
        "cosmos-auto-update": "true",
        "cosmos-force-network-secured": "true",
        "cosmos.stack": "{ServiceName}"
      },
      "networks": {
        "media-stack": {}
      }
    }
  },
  "networks": {
    "media-stack": {
      "name": "media-stack",
      "external": true
    }
  }
}