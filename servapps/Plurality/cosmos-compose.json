{
  "name": "Plurality",
  "cosmos-installer": {
    "form": [
      {
        "name": "ConfigRoot",
        "label": "Host Config Root Path",
        "initialValue": "/srv/config",
        "type": "text",
        "required": true
      },
      {
        "name": "OpenRouterApiKey",
        "label": "OpenRouter API Key",
        "type": "password",
        "required": true
      },
      {
        "name": "AdminUser",
        "label": "Initial Admin Username",
        "initialValue": "admin",
        "type": "text",
        "required": true
      },
      {
        "name": "AdminPassword",
        "label": "Initial Admin Password",
        "type": "password",
        "required": true
      },
      {
        "name": "adminOnly",
        "label": "Do you want to make this service admin only?",
        "initialValue": false,
        "type": "checkbox"
      }
    ],
    "post-install": "Sign in using the administrator account created during installation. You can then connect OpenRouter and configure your supported Arr applications."
  },
  "minVersion": "0.9.0",
  "services": {
    "{ServiceName}": {
      "image": "azukaar/plurality:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "environment": [
        "OPENROUTER_API_KEY={Context.OpenRouterApiKey}",
        "INIT_ADMIN_USER={Context.AdminUser}",
        "INIT_ADMIN_PASSWORD={Context.AdminPassword}"
      ],
      "volumes": [
        {
          "source": "{Context.ConfigRoot}/plurality",
          "target": "/app/data",
          "type": "bind"
        },
        {
          "source": "{Context.ConfigRoot}/plurality/users",
          "target": "/app/users-data",
          "type": "bind"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:8090",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          },
          "AuthEnabled": true
          {if Context.adminOnly}
          ,
          "AuthAdmin": true
          {/if}
        }
      ],
      "labels": {
        "cosmos-auto-update": "true",
        "cosmos-force-network-secured": "true",
        "cosmos-persistent-env": "OPENROUTER_API_KEY,INIT_ADMIN_USER,INIT_ADMIN_PASSWORD",
        "cosmos-icon": "https://veneziaisking.github.io/cosmos-servapps/servapps/Plurality/icon.png",
        "cosmos.stack": "{ServiceName}"
      },
      "networks": {
        "media-stack": {}
      }
    }
  },
  "networks": {
    "media-stack": {
      "name": "media-stack",
      "external": true
    }
  }
}